# Origin of the Community Hub FastAPI backend (no trailing slash, no /api).
# Leave empty to run the app against the built-in demo data stored in the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# OAuth 2.0 Web client ID from Google Cloud Console (APIs & Services > Credentials).
# Add http://localhost:3000 and your production URL under "Authorized JavaScript origins".
# The backend must accept POST /api/auth/google with {"id_token": "..."}, verify the token
# against this same client ID, and return the same response as /api/auth/login.
# Leave empty to hide Google sign-in (demo mode shows a simulated button instead).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
